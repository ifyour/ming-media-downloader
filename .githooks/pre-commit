#!/bin/sh
# Pre-commit hook lint => typecheck => test (fail fast).
# Skip with `git commit --no-verify` (-n).
# Configured via: git config core.hooksPath .githooks

set -e

step=0
fail() {
  echo "FAILED at step $step: $1"
  exit 1
}

step=1
echo "=== [1/3] Lint ==="
pnpm lint || fail "Lint must pass"

step=2
echo "=== [2/3] Typecheck + Build ==="
pnpm build || fail "Build (typecheck + bundle) must pass"

step=3
echo "=== [3/3] Tests ==="
pnpm test || fail "Tests must pass"

echo "=== All checks passed ==="
