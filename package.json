{
  "name": "ming-media-downloader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "browserslist": [
    "iOS >= 12",
    "last 2 versions",
    "> 1%"
  ],
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c blue,green \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "wrangler dev worker/src/index.ts --port 8787",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy": "pnpm deploy:backend && pnpm deploy:frontend",
    "deploy:frontend": "pnpm build && wrangler pages deploy dist --project-name ming-media-downloader",
    "deploy:backend": "wrangler deploy worker/src/index.ts --name ming-media-downloader-api",
    "test": "vitest run --config vitest.worker.config.ts --passWithNoTests --exclude '**/*.fallback.test.ts' && vitest run --config vitest.frontend.config.ts --passWithNoTests",
    "test:full": "vitest run --config vitest.worker.config.ts --passWithNoTests && vitest run --config vitest.frontend.config.ts --passWithNoTests",
    "test:fallback": "vitest run --config vitest.worker.config.ts tests/worker/*.fallback.test.ts",
    "test:frontend": "vitest run --config vitest.frontend.config.ts --passWithNoTests",
    "test:worker": "vitest run --config vitest.worker.config.ts --passWithNoTests",
    "test:watch": "vitest --config vitest.worker.config.ts --exclude '**/*.fallback.test.ts'",
    "test:watch:frontend": "vitest --config vitest.frontend.config.ts"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  }
}
