{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types", "@testing-library/jest-dom"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "worker/**/*.test.ts",
    "frontend/**/*.test.ts",
    "frontend/**/*.test.tsx",
    "frontend/setup.ts",
    "frontend/*.d.ts"
  ]
}
